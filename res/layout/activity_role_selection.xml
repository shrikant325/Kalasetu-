<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0EEFF">

    <!-- ═══════════════════════════════════════════
         HERO BAND — deep violet top section
    ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/heroBand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#5B21B6"
        android:paddingBottom="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.32">

        <!-- Decorative top-right lines -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingEnd="28dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <View
                    android:layout_width="52dp"
                    android:layout_height="2dp"
                    android:background="#C4B5FD"
                    android:layout_marginBottom="5dp" />
                <View
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:background="#C4B5FD"
                    android:alpha="0.4"
                    android:layout_gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.03"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_role"
            android:textSize="14sp"
            android:textColor="#DDD6FE"
            android:letterSpacing="0.04" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         SCROLL AREA — role cards
    ═══════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="-24dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/heroBand"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="8dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT YOUR ROLE"
                android:textColor="#9B8FC0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="18dp" />

            <!-- ══════════════════════
                 CARD — USER
            ══════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <!-- Icon box -->
                    <LinearLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:gravity="center"
                        android:background="#EDE9FE"
                        android:layout_marginEnd="18dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👤"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <!-- Text col -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_user"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A0E35"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_user_desc"
                            android:textSize="13sp"
                            android:textColor="#9B8FC0"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                    <!-- Arrow -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="#7C3AED"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <!-- Bottom accent bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#7C3AED"
                    android:alpha="0.15"
                    android:layout_gravity="bottom" />

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════
                 CARD — ARTIST
            ══════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <!-- Icon box -->
                    <LinearLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:gravity="center"
                        android:background="#F3E8FF"
                        android:layout_marginEnd="18dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <!-- Text col -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_artist"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A0E35"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_artist_desc"
                            android:textSize="13sp"
                            android:textColor="#9B8FC0"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                    <!-- Arrow -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="#7C3AED"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <!-- Bottom accent bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#7C3AED"
                    android:alpha="0.15"
                    android:layout_gravity="bottom" />

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════
                 CARD — ADMIN
            ══════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <!-- Icon box -->
                    <LinearLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:gravity="center"
                        android:background="#FFF0F0"
                        android:layout_marginEnd="18dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <!-- Text col -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_admin"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A0E35"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_admin_desc"
                            android:textSize="13sp"
                            android:textColor="#9B8FC0"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                    <!-- Arrow -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="28sp"
                        android:textColor="#DC2626"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <!-- Bottom accent bar — red for admin -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#DC2626"
                    android:alpha="0.15"
                    android:layout_gravity="bottom" />

            </androidx.cardview.widget.CardView>

            <!-- Bottom lock note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒  Secure &amp; encrypted access"
                android:textColor="#C4B5FD"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>