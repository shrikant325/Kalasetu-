<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:radius="24dp"
    android:elevation="6dp"
    android:backgroundTint="#1B3A57"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BAND -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0F2A40"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Painting icon frame -->
            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:background="#4FC3F7"
                android:padding="2dp"
                android:layout_marginEnd="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="#0D2137">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼"
                        android:textSize="20sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/txtPaintingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Painting Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E6F1FF" />

            <!-- Arrow indicator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#4FC3F7"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- BOTTOM ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:background="#4FC3F7"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to view details"
                android:textSize="13sp"
                android:textColor="#9BB6CF" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>