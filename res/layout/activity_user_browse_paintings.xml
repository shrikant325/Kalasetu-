<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <View
            android:id="@+id/topAccentBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignParentTop="true"
            android:background="#C17B3F" />

        <View
            android:id="@+id/leftAccentPill"
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:layout_below="@id/topAccentBar"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#C17B3F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse Paintings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:padding="16dp"
            android:layout_below="@id/topAccentBar"
            android:layout_toEndOf="@id/leftAccentPill" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBrowsePaintings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>