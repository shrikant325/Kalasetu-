<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ┌──────────────────────────────────────────┐
             │  TOP HERO — vibrant violet header        │
             └──────────────────────────────────────────┘ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="36dp"
            android:background="#6C63FF">

            <!-- Avatar: white border + lavender inner + icon -->
            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="#EDE8FF">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@android:drawable/ic_lock_lock"
                        android:tint="#6C63FF" />

                </LinearLayout>
            </LinearLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/txtAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.02"
                android:layout_marginTop="18dp" />

            <!-- Username -->
            <TextView
                android:id="@+id/txtAdminUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@admin"
                android:textColor="#D4D0FF"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

            <!-- Badge pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦  SUPER ADMIN"
                android:textColor="#6C63FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <!-- ┌──────────────────────────────────────────┐
             │  STATUS STRIP — only Live status         │
             └──────────────────────────────────────────┘ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:layout_marginBottom="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Active"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—  Session is live"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ┌──────────────────────────────────────────┐
             │  ADMIN INFO CARD                         │
             └──────────────────────────────────────────┘ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <!-- Role row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <!-- Icon block -->
                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:background="#EDE8FF"
                    android:layout_marginEnd="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtAdminRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Role: ADMIN"
                        android:textColor="#1A1A2E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full system privileges"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textColor="#6C63FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#EDE8FF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F4F4F4"
                android:layout_marginBottom="12dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/txtAdminDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You have full access to manage users, artists, and paintings."
                android:textColor="#888888"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- ┌──────────────────────────────────────────┐
             │  SECTION LABEL                           │
             └──────────────────────────────────────────┘ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIONS"
            android:textColor="#C0C0C0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="10dp" />

        <!-- ┌──────────────────────────────────────────┐
             │  BTN — View All Users                    │
             └──────────────────────────────────────────┘ -->
        <Button
            android:id="@+id/btnViewUsers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="👥   View All Users"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:backgroundTint="#6C63FF"
            android:layout_marginTop="16dp"
            android:stateListAnimator="@null"
            android:elevation="6dp" />

        <!-- ┌──────────────────────────────────────────┐
             │  BTN — View All Artists                  │
             └──────────────────────────────────────────┘ -->
        <Button
            android:id="@+id/btnViewArtists"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🎨   View All Artists"
            android:textColor="#6C63FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:backgroundTint="#EDE8FF"
            android:layout_marginTop="10dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- ┌──────────────────────────────────────────┐
             │  BTN — Approve Painting                  │
             └──────────────────────────────────────────┘ -->
        <Button
            android:id="@+id/btnApprovePainting"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅   Approve Painting"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:backgroundTint="#DCFCE7"
            android:layout_marginTop="10dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- ┌──────────────────────────────────────────┐
             │  DANGER ZONE divider                     │
             └──────────────────────────────────────────┘ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#FFE4E4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  DANGER ZONE  "
                android:textColor="#EF4444"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#FFE4E4" />

        </LinearLayout>

        <!-- ┌──────────────────────────────────────────┐
             │  BTN — Logout                            │
             └──────────────────────────────────────────┘ -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⏻   Logout"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:backgroundTint="#FFF1F1"
            android:layout_marginTop="20dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- Bottom spacer -->
        <View android:layout_width="match_parent" android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>