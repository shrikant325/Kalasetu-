<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- SAFE TOP SPACING -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- ══ TOP LABEL ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="4dp"
                android:layout_height="16dp"
                android:background="#FF6B35"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAINTING REVIEW"
                android:textColor="#FF6B35"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

        </LinearLayout>

        <!-- ══ IMAGE CARD ══ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:radius="0dp"
            android:elevation="0dp"
            android:backgroundTint="#F7F7F7"
            android:layout_marginBottom="0dp">

            <com.github.chrisbanes.photoview.PhotoView
                android:id="@+id/imgPainting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:contentDescription="Painting Image" />

            <!-- Pinch hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⊕ Zoom"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#CC000000"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp" />

        </androidx.cardview.widget.CardView>

        <!-- ══ MAIN CONTENT PAD ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Painting Title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:textAlignment="center"
                android:layout_marginBottom="10dp" />

            <!-- ORANGE ACCENT DIVIDER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:background="#FFD4BC" />

                <View
                    android:layout_width="50dp"
                    android:layout_height="3dp"
                    android:background="#FF6B35" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:background="#FFD4BC" />

            </LinearLayout>

            <!-- ══ DESCRIPTION CARD ══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:radius="16dp"
                android:elevation="4dp"
                android:backgroundTint="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Card top accent strip -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="#FF6B35"
                        android:layout_marginBottom="14dp" />

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#888888"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Painting description goes here"
                        android:textSize="15sp"
                        android:lineSpacingExtra="7dp"
                        android:textColor="#333333" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ PRICE CARD ══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:radius="16dp"
                android:elevation="4dp"
                android:backgroundTint="#FFF6F2"
                android:layout_marginBottom="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <!-- Price label col -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#AAAAAA"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Listed amount"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Price value -->
                    <TextView
                        android:id="@+id/txtPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ₹ 0"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#FF6B35" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVIEW DECISION"
                android:textColor="#BBBBBB"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="14dp" />

            <!-- ══ APPROVE BUTTON ══ -->
            <Button
                android:id="@+id/btnApprove"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="✓   APPROVE PAINTING"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:letterSpacing="0.06"
                android:backgroundTint="#22A855"
                android:layout_marginBottom="12dp"
                android:stateListAnimator="@null"
                android:elevation="4dp" />

            <!-- OR DIVIDER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  or  "
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#EEEEEE" />

            </LinearLayout>

            <!-- ══ REJECT BUTTON ══ -->
            <Button
                android:id="@+id/btnReject"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="✕   REJECT PAINTING"
                android:textStyle="bold"
                android:textColor="#E53935"
                android:textSize="15sp"
                android:letterSpacing="0.06"
                android:backgroundTint="#FFF0F0"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <!-- Bottom spacer -->
            <View android:layout_width="match_parent" android:layout_height="32dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>