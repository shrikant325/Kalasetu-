<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F4FF">

    <!-- ═══════════════════════════════════════════
         TOP VIOLET HERO BAND
    ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/heroBand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#7C3AED"
        android:paddingTop="56dp"
        android:paddingBottom="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Lock icon circle -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="#EDE9FE">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑"
                    android:textSize="28sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- App title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalasetu"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.03" />

        <!-- Sub label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Recovery"
            android:textColor="#DDD6FE"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         FORM CARD
    ═══════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/heroBand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Card top accent bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="#7C3AED"
                android:layout_marginBottom="14dp" />

            <!-- Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recover Account"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A0E35"
                android:layout_marginBottom="6dp" />

            <!-- Sub heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your credentials to reset access"
                android:textColor="#A89FC0"
                android:textSize="13sp"
                android:layout_marginBottom="22dp" />

            <!-- ── Phone field ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="#6B6690"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Registered Phone Number"
                android:inputType="phone"
                android:textColor="#1A0E35"
                android:textColorHint="#C4B5FD"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="#F6F4FF"
                android:layout_marginBottom="16dp" />

            <!-- ── Secret Code field ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secret Code"
                android:textColor="#6B6690"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#7C3AED"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#7C3AED"
                app:boxBackgroundColor="#F6F4FF"
                app:hintTextColor="#7C3AED"
                app:boxCornerRadiusTopStart="0dp"
                app:boxCornerRadiusTopEnd="0dp"
                app:boxCornerRadiusBottomStart="0dp"
                app:boxCornerRadiusBottomEnd="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSecretCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter secret code"
                    android:inputType="textPassword"
                    android:textColor="#1A0E35"
                    android:textColorHint="#C4B5FD"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── New Password field ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Password"
                android:textColor="#6B6690"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#7C3AED"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#7C3AED"
                app:boxBackgroundColor="#F6F4FF"
                app:hintTextColor="#7C3AED"
                app:boxCornerRadiusTopStart="0dp"
                app:boxCornerRadiusTopEnd="0dp"
                app:boxCornerRadiusBottomStart="0dp"
                app:boxCornerRadiusBottomEnd="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Create new password"
                    android:inputType="textPassword"
                    android:textColor="#1A0E35"
                    android:textColorHint="#C4B5FD"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Recover Button ── -->
            <Button
                android:id="@+id/btnRecover"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔑   RECOVER ACCOUNT"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:backgroundTint="#7C3AED"
                android:stateListAnimator="@null"
                android:elevation="6dp" />

            <!-- ── Success result label ── -->
            <TextView
                android:id="@+id/txtRecoveredUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#16A34A"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember your password? Go back and sign in."
        android:textColor="#A89FC0"
        android:textSize="12sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/heroBand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>