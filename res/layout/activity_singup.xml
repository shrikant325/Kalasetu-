<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0EEFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════
             HERO BAND
        ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#5B21B6"
            android:paddingBottom="36dp">

            <!-- Decorative lines top right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingEnd="28dp"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View
                        android:layout_width="52dp"
                        android:layout_height="2dp"
                        android:background="#C4B5FD"
                        android:layout_marginBottom="5dp" />
                    <View
                        android:layout_width="32dp"
                        android:layout_height="2dp"
                        android:background="#C4B5FD"
                        android:alpha="0.4"
                        android:layout_gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Avatar -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="#7C3AED">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✍️"
                        android:textSize="28sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kalasetu"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.03"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join the art community"
                android:textColor="#DDD6FE"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════
             FORM CARD — overlapping hero
        ═══════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="-28dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="30dp"
                android:paddingBottom="28dp">

                <!-- Card top accent -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="#7C3AED"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A0E35"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fill in your details to get started"
                    android:textColor="#9B8FC0"
                    android:textSize="13sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="28dp" />

                <!-- ── FULL NAME ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textColor="#7C3AED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#F5F0FF"
                    app:boxStrokeColor="#7C3AED"
                    app:hintTextColor="#9B8FC0"
                    app:boxCornerRadiusTopStart="0dp"
                    app:boxCornerRadiusTopEnd="0dp"
                    app:boxCornerRadiusBottomStart="0dp"
                    app:boxCornerRadiusBottomEnd="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your full name"
                        android:textColor="#1A0E35"
                        android:textColorHint="#C4B5FD"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── USERNAME ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERNAME"
                    android:textColor="#7C3AED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#F5F0FF"
                    app:boxStrokeColor="#7C3AED"
                    app:hintTextColor="#9B8FC0"
                    app:boxCornerRadiusTopStart="0dp"
                    app:boxCornerRadiusTopEnd="0dp"
                    app:boxCornerRadiusBottomStart="0dp"
                    app:boxCornerRadiusBottomEnd="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Username (@ allowed)"
                        android:textColor="#1A0E35"
                        android:textColorHint="#C4B5FD"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── PHONE ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE NUMBER"
                    android:textColor="#7C3AED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#F5F0FF"
                    app:boxStrokeColor="#7C3AED"
                    app:hintTextColor="#9B8FC0"
                    app:boxCornerRadiusTopStart="0dp"
                    app:boxCornerRadiusTopEnd="0dp"
                    app:boxCornerRadiusBottomStart="0dp"
                    app:boxCornerRadiusBottomEnd="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter phone number"
                        android:inputType="phone"
                        android:textColor="#1A0E35"
                        android:textColorHint="#C4B5FD"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── ADDRESS ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADDRESS"
                    android:textColor="#7C3AED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#F5F0FF"
                    app:boxStrokeColor="#7C3AED"
                    app:hintTextColor="#9B8FC0"
                    app:boxCornerRadiusTopStart="0dp"
                    app:boxCornerRadiusTopEnd="0dp"
                    app:boxCornerRadiusBottomStart="0dp"
                    app:boxCornerRadiusBottomEnd="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter your address"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="#1A0E35"
                        android:textColorHint="#C4B5FD"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#EDE9FE" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Security  "
                        android:textColor="#C4B5FD"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#EDE9FE" />
                </LinearLayout>

                <!-- ── SECRET CODE ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECRET CODE"
                    android:textColor="#7C3AED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#7C3AED"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#F5F0FF"
                    app:boxStrokeColor="#7C3AED"
                    app:hintTextColor="#9B8FC0"
                    app:boxCornerRadiusTopStart="0dp"
                    app:boxCornerRadiusTopEnd="0dp"
                    app:boxCornerRadiusBottomStart="0dp"
                    app:boxCornerRadiusBottomEnd="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecretCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Secret Code (Do not forget)"
                        android:inputType="textPassword"
                        android:textColor="#1A0E35"
                        android:textColorHint="#C4B5FD"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── PASSWORD ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textColor="#7C3AED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#7C3AED"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="#F5F0FF"
                    app:boxStrokeColor="#7C3AED"
                    app:hintTextColor="#9B8FC0"
                    app:boxCornerRadiusTopStart="0dp"
                    app:boxCornerRadiusTopEnd="0dp"
                    app:boxCornerRadiusBottomStart="0dp"
                    app:boxCornerRadiusBottomEnd="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Create a strong password"
                        android:inputType="textPassword"
                        android:textColor="#1A0E35"
                        android:textColorHint="#C4B5FD"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- SIGNUP BUTTON -->
                <Button
                    android:id="@+id/btnSignup"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="S I G N  U P"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:backgroundTint="#7C3AED"
                    android:stateListAnimator="@null"
                    android:elevation="8dp"
                    android:layout_marginBottom="20dp" />

                <!-- Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#EDE9FE" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  ✦  "
                        android:textColor="#C4B5FD"
                        android:textSize="12sp" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#EDE9FE" />
                </LinearLayout>

                <!-- Login redirect -->
                <TextView
                    android:id="@+id/txtLoginRedirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account?  Login →"
                    android:textColor="#7C3AED"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>